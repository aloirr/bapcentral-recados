+RE_UF = re.compile(r"^[A-Z]{2}$")
+MAX_RECORTES = 30
+
+
+def _recortes_erros(rec) -> str | None:
+    """T-0014: visões prontas por estado e supervisor (opcional). Só formato: o número vem pronto do PC."""
+    if rec is None:
+        return None
+    if not isinstance(rec, dict):
+        return "recortes precisa ser objeto"
+    ufs, sup = rec.get("uf") or {}, rec.get("supervisor") or {}
+    if not isinstance(ufs, dict) or not isinstance(sup, dict):
+        return "recortes.uf e recortes.supervisor precisam ser objetos"
+    if len(ufs) > MAX_RECORTES or len(sup) > MAX_RECORTES:
+        return "recortes demais"
+    for uf, v in ufs.items():
+        cs = v.get("cartoes") if isinstance(v, dict) else None
+        if not RE_UF.match(str(uf)) or not isinstance(cs, list) or not all(_cartao_ok(c) for c in cs):
+            return f"recorte {str(uf)[:4]} inválido"
+    for k, uf in sup.items():
+        if not isinstance(k, str) or not 0 < len(k) <= 40 or uf not in ufs:
+            return "recortes.supervisor precisa apontar para um estado do recorte"
+    return None
+
